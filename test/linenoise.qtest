#!/usr/bin/env qore

%requires linenoise

%modern

%requires QUnit
%requires Util
%requires FsUtil

%exec-class LinenoiseTest

class LinenoiseTest inherits Test {
    private {
        string tmp_dir;
    }

    constructor() : Test("LinenoiseTest", "1.0") {
        tmp_dir = make_tmp_dir();

        # Terminal dimension tests
        addTestCase("columns() returns valid width", \testColumns());
        addTestCase("rows() returns valid height", \testRows());

        # History basic operations
        addTestCase("history_add() basic functionality", \testHistoryAddBasic());
        addTestCase("history_get_max_len() default value", \testHistoryGetMaxLenDefault());
        addTestCase("history_set_max_len() basic functionality", \testHistorySetMaxLen());
        addTestCase("history() returns list", \testHistoryReturnsList());
        addTestCase("history_free() clears history", \testHistoryFree());

        # History limits and edge cases
        addTestCase("history respects max length", \testHistoryMaxLength());
        addTestCase("history duplicate prevention", \testHistoryDuplicates());
        addTestCase("history empty string handling", \testHistoryEmptyString());

        # History persistence
        addTestCase("history_save() and history_load() basic", \testHistorySaveLoad());
        addTestCase("history_save() error handling", \testHistorySaveError());
        addTestCase("history_load() error handling", \testHistoryLoadError());
        addTestCase("history_load() non-existent file", \testHistoryLoadNonExistent());

        # UTF-8 tests
        addTestCase("UTF-8 history add and retrieve", \testUTF8History());
        addTestCase("UTF-8 CJK characters in history", \testUTF8CJK());
        addTestCase("UTF-8 emoji in history", \testUTF8Emoji());
        addTestCase("UTF-8 combining characters in history", \testUTF8Combining());
        addTestCase("UTF-8 mixed scripts in history", \testUTF8MixedScripts());
        addTestCase("UTF-8 history persistence", \testUTF8Persistence());

        # Callback tests
        addTestCase("set_callback() accepts closure", \testSetCallbackClosure());
        addTestCase("set_callback() accepts function reference", \testSetCallbackFunctionRef());
        addTestCase("set_callback() can be replaced", \testSetCallbackReplace());

        # Hints callback tests
        addTestCase("set_hints_callback() accepts closure", \testSetHintsCallbackClosure());
        addTestCase("set_hints_callback() accepts function reference", \testSetHintsCallbackFuncRef());
        addTestCase("set_hints_callback() can be replaced", \testSetHintsCallbackReplace());
        addTestCase("set_hints_callback() hash return", \testSetHintsCallbackHash());
        addTestCase("set_hints_callback() clear with NOTHING", \testSetHintsCallbackClear());

        # Preload buffer tests
        addTestCase("preload_buffer() basic", \testPreloadBufferBasic());

        # Mask mode tests
        addTestCase("set_mask_mode() enable and disable", \testSetMaskMode());
        addTestCase("set_mask_mode() toggle multiple times", \testSetMaskModeToggle());

        # Auto-dedent tests
        addTestCase("set_auto_dedent() basic", \testSetAutoDedent());

        # Completion enhancement tests
        addTestCase("set_menu_complete() enable and disable", \testSetMenuComplete());
        addTestCase("set_completion_case_insensitive() enable and disable", \testSetCompletionCaseInsensitive());
        addTestCase("set_filename_completion() enable and disable", \testSetFilenameCompletion());

        # Timeout tests
        addTestCase("line_with_timeout() API callable", \testLineWithTimeoutApi());
        addTestCase("line_with_timeout() rejects invalid timeout", \testLineWithTimeoutValidation());

        # Syntax highlighting tests
        addTestCase("set_syntax_callback() set, replace, and clear", \testSetSyntaxCallback());

        # Right prompt tests
        addTestCase("set_right_prompt() set and clear", \testSetRightPrompt());

        # Key binding tests
        addTestCase("bind_key() and unbind_key() basic", \testBindKey());
        addTestCase("bind_key() replaces existing binding", \testBindKeyReplace());
        addTestCase("bind_key() invalid key spec", \testBindKeyInvalidSpec());
        addTestCase("unbind_key() invalid key spec", \testUnbindKeyInvalidSpec());

        # Negative tests
        addTestCase("history_set_max_len() rejects zero", \testSetMaxLenZero());
        addTestCase("history_set_max_len() rejects negative", \testSetMaxLenNegative());

        # Corner cases
        addTestCase("history with special characters", \testHistorySpecialChars());
        addTestCase("history with very long lines", \testHistoryLongLines());
        addTestCase("history max len change truncates", \testMaxLenChangeTruncates());
        addTestCase("multiple save/load cycles", \testMultipleSaveLoadCycles());

        set_return_value(main());
    }

    destructor() {
        # Clean up temp directory
        if (tmp_dir) {
            remove_tree(tmp_dir);
        }
    }

    resetHistory() {
        # Reset history before each test
        Linenoise::history_free();
        Linenoise::history_set_max_len(100);
    }

    # ==================== Terminal Dimension Tests ====================

    testColumns() {
        resetHistory();
        int cols = Linenoise::columns();
        # Should return a positive value (defaults to 80 if detection fails)
        assertGt(0, cols);
        # Reasonable upper bound for terminal width
        assertLt(10000, cols);
    }

    testRows() {
        resetHistory();
        int r = Linenoise::rows();
        # Should return a positive value (defaults to 24 if detection fails)
        assertGt(0, r);
        # Reasonable upper bound for terminal height
        assertLt(10000, r);
    }

    # ==================== History Basic Operations ====================

    testHistoryAddBasic() {
        resetHistory();
        int result = Linenoise::history_add("test line");
        assertEq(1, result);

        list<auto> h = Linenoise::history();
        assertEq(1, h.size());
        assertEq("test line", h[0]);
    }

    testHistoryGetMaxLenDefault() {
        resetHistory();
        Linenoise::history_free();
        # Default max length is 100 as per linenoise.cpp
        Linenoise::history_set_max_len(100);
        int maxLen = Linenoise::history_get_max_len();
        assertEq(100, maxLen);
    }

    testHistorySetMaxLen() {
        resetHistory();
        int result = Linenoise::history_set_max_len(50);
        assertEq(1, result);
        assertEq(50, Linenoise::history_get_max_len());

        result = Linenoise::history_set_max_len(200);
        assertEq(1, result);
        assertEq(200, Linenoise::history_get_max_len());
    }

    testHistoryReturnsList() {
        resetHistory();
        list<auto> h = Linenoise::history();
        assertEq(Type::List, h.type());
        assertEq(0, h.size());

        Linenoise::history_add("line1");
        Linenoise::history_add("line2");
        h = Linenoise::history();
        assertEq(2, h.size());
    }

    testHistoryFree() {
        resetHistory();
        Linenoise::history_add("line1");
        Linenoise::history_add("line2");
        list<auto> h = Linenoise::history();
        assertEq(2, h.size());

        Linenoise::history_free();
        h = Linenoise::history();
        assertEq(0, h.size());
    }

    # ==================== History Limits and Edge Cases ====================

    testHistoryMaxLength() {
        resetHistory();
        Linenoise::history_set_max_len(5);

        for (int i = 0; i < 10; i++) {
            Linenoise::history_add(sprintf("line%d", i));
        }

        list<auto> h = Linenoise::history();
        assertEq(5, h.size());
        # Should have the last 5 entries (oldest removed)
        assertEq("line5", h[0]);
        assertEq("line9", h[4]);
    }

    testHistoryDuplicates() {
        resetHistory();
        Linenoise::history_add("first");
        Linenoise::history_add("second");
        Linenoise::history_add("second");  # Should not add - same as most recent

        list<auto> h = Linenoise::history();
        # Linenoise only prevents consecutive duplicates (same as most recent)
        assertEq(2, h.size());
        assertEq("first", h[0]);
        assertEq("second", h[1]);

        # Adding a different entry, then the same again should work
        Linenoise::history_add("third");
        Linenoise::history_add("second");  # This WILL be added - not consecutive duplicate
        h = Linenoise::history();
        assertEq(4, h.size());
    }

    testHistoryEmptyString() {
        resetHistory();
        # Adding empty string - test that it doesn't crash
        Linenoise::history_add("");
        # Empty strings are added to in-memory history but skipped on save
        list<auto> h = Linenoise::history();
        assertEq(1, h.size());
        assertEq("", h[0]);
    }

    # ==================== History Persistence ====================

    testHistorySaveLoad() {
        resetHistory();
        string filename = tmp_dir + "/history_basic.txt";

        Linenoise::history_add("line1");
        Linenoise::history_add("line2");
        Linenoise::history_add("line3");

        Linenoise::history_save(filename);
        assertTrue(is_file(filename));

        Linenoise::history_free();
        list<auto> h = Linenoise::history();
        assertEq(0, h.size());

        Linenoise::history_load(filename);
        h = Linenoise::history();
        assertEq(3, h.size());
        assertEq("line1", h[0]);
        assertEq("line2", h[1]);
        assertEq("line3", h[2]);

        unlink(filename);
    }

    testHistorySaveError() {
        resetHistory();
        # Try to save to an invalid path
        string invalid_path = "/nonexistent_dir_12345/history.txt";

        assertThrows("LINENOISE-HISTORY-SAVE-ERROR", sub() {
            Linenoise::history_save(invalid_path);
        });
    }

    testHistoryLoadError() {
        resetHistory();
        # Try to load from a directory - should fail or return empty
        # The behavior varies by OS, but we can verify it doesn't corrupt state
        int initial_len = Linenoise::history_get_max_len();
        try {
            Linenoise::history_load("/");
        } catch (hash<ExceptionInfo> ex) {
            # Expected on some systems
        }
        # Verify history state is still valid after failed/empty load
        assertEq(initial_len, Linenoise::history_get_max_len());
    }

    testHistoryLoadNonExistent() {
        resetHistory();
        string nonexistent = tmp_dir + "/nonexistent_file.txt";

        assertThrows("LINENOISE-HISTORY-LOAD-ERROR", sub() {
            Linenoise::history_load(nonexistent);
        });
    }

    # ==================== UTF-8 Tests ====================

    testUTF8History() {
        resetHistory();
        # Basic UTF-8 - Latin extended characters
        string utf8_str = "caf\u00e9 na\u00efve r\u00e9sum\u00e9";  # cafe naive resume with accents
        Linenoise::history_add(utf8_str);

        list<auto> h = Linenoise::history();
        assertEq(1, h.size());
        assertEq(utf8_str, h[0]);
    }

    testUTF8CJK() {
        resetHistory();
        # Chinese characters
        string chinese = "\u4e2d\u6587\u6d4b\u8bd5";  # "Chinese test" in Chinese
        # Japanese characters (hiragana + kanji)
        string japanese = "\u3053\u3093\u306b\u3061\u306f\u4e16\u754c";  # "Hello world" in Japanese
        # Korean characters
        string korean = "\uc548\ub155\ud558\uc138\uc694";  # "Hello" in Korean

        Linenoise::history_add(chinese);
        Linenoise::history_add(japanese);
        Linenoise::history_add(korean);

        list<auto> h = Linenoise::history();
        assertEq(3, h.size());
        assertEq(chinese, h[0]);
        assertEq(japanese, h[1]);
        assertEq(korean, h[2]);
    }

    testUTF8Emoji() {
        resetHistory();
        # Various emoji (require surrogate pairs in UTF-16)
        string emoji = "\U0001F600\U0001F389\U0001F680\U0001F4BB";  # grinning face, party popper, rocket, laptop

        Linenoise::history_add(emoji);
        Linenoise::history_add("text with emoji: \U0001F44D");  # thumbs up

        list<auto> h = Linenoise::history();
        assertEq(2, h.size());
        assertEq(emoji, h[0]);
        assertEq("text with emoji: \U0001F44D", h[1]);
    }

    testUTF8Combining() {
        resetHistory();
        # Characters with combining marks
        string combining = "e\u0301";  # e + combining acute accent = é (e with acute accent)
        string precomposed = "\u00e9";  # precomposed é with acute

        Linenoise::history_add(combining);
        Linenoise::history_add(precomposed);

        list<auto> h = Linenoise::history();
        assertEq(2, h.size());
        assertEq(combining, h[0]);
        assertEq(precomposed, h[1]);
    }

    testUTF8MixedScripts() {
        resetHistory();
        # Mixed scripts in single string
        string mixed = "Hello \u4e16\u754c \u041f\u0440\u0438\u0432\u0435\u0442 \u0645\u0631\u062d\u0628\u0627";
        # English + Chinese + Russian + Arabic

        Linenoise::history_add(mixed);

        list<auto> h = Linenoise::history();
        assertEq(1, h.size());
        assertEq(mixed, h[0]);
    }

    testUTF8Persistence() {
        resetHistory();
        string filename = tmp_dir + "/history_utf8.txt";

        # Add various UTF-8 strings
        string russian = "\u041f\u0440\u0438\u0432\u0435\u0442 \u043c\u0438\u0440";  # "Hello world" in Russian
        string greek = "\u0393\u03b5\u03b9\u03ac \u03c3\u03bf\u03c5 \u03ba\u03cc\u03c3\u03bc\u03b5";  # "Hello world" in Greek
        string hebrew = "\u05e9\u05dc\u05d5\u05dd \u05e2\u05d5\u05dc\u05dd";  # "Hello world" in Hebrew
        string thai = "\u0e2a\u0e27\u0e31\u0e2a\u0e14\u0e35\u0e42\u0e25\u0e01";  # "Hello world" in Thai

        Linenoise::history_add(russian);
        Linenoise::history_add(greek);
        Linenoise::history_add(hebrew);
        Linenoise::history_add(thai);

        Linenoise::history_save(filename);

        Linenoise::history_free();
        Linenoise::history_load(filename);

        list<auto> h = Linenoise::history();
        assertEq(4, h.size());
        assertEq(russian, h[0]);
        assertEq(greek, h[1]);
        assertEq(hebrew, h[2]);
        assertEq(thai, h[3]);

        unlink(filename);
    }

    # ==================== Callback Tests ====================

    testSetCallbackClosure() {
        resetHistory();
        code callback = list<string> sub(string input) {
            return ("completion1", "completion2");
        };

        # Verify setting callback doesn't throw - test passes if no exception
        assertNothing(Linenoise::set_callback(callback));
    }

    testSetCallbackFunctionRef() {
        resetHistory();
        # Verify setting callback with function reference doesn't throw
        assertNothing(Linenoise::set_callback(\dummyCallback()));
    }

    testSetCallbackReplace() {
        resetHistory();
        code callback1 = list<string> sub(string input) {
            return ("first",);
        };
        code callback2 = list<string> sub(string input) {
            return ("second",);
        };

        # Verify callbacks can be replaced without error
        assertNothing(Linenoise::set_callback(callback1));
        assertNothing(Linenoise::set_callback(callback2));
    }

    # ==================== Hints Callback Tests ====================

    testSetHintsCallbackClosure() {
        resetHistory();
        code<auto(string)> callback = auto sub (string input) {
            if (input == "printf(") {
                return " string fmt, ...";
            }
        };

        # Verify setting hints callback doesn't throw
        assertNothing(Linenoise::set_hints_callback(callback));
    }

    testSetHintsCallbackFuncRef() {
        resetHistory();
        # Verify setting hints callback with function reference doesn't throw
        assertNothing(Linenoise::set_hints_callback(\dummyHintsCallback()));
    }

    testSetHintsCallbackReplace() {
        resetHistory();
        code<auto(string)> callback1 = auto sub (string input) {
            return " hint 1";
        };
        code<auto(string)> callback2 = auto sub (string input) {
            return " hint 2";
        };

        # Verify callbacks can be replaced without error
        assertNothing(Linenoise::set_hints_callback(callback1));
        assertNothing(Linenoise::set_hints_callback(callback2));
    }

    testSetHintsCallbackHash() {
        resetHistory();
        code<auto(string)> callback = auto sub (string input) {
            return {"text": " some hint", "color": 33, "bold": True};
        };

        # Verify setting hints callback with hash-returning closure doesn't throw
        assertNothing(Linenoise::set_hints_callback(callback));
    }

    testSetHintsCallbackClear() {
        resetHistory();
        # Set a callback first
        assertNothing(Linenoise::set_hints_callback(\dummyHintsCallback()));
        # Clear it with NOTHING
        assertNothing(Linenoise::set_hints_callback());
        # Set and clear again to verify no double-free
        assertNothing(Linenoise::set_hints_callback(\dummyHintsCallback()));
        assertNothing(Linenoise::set_hints_callback());
    }

    # ==================== Preload Buffer Tests ====================

    testPreloadBufferBasic() {
        resetHistory();
        # Verify preload_buffer() returns NOTHING for various inputs
        # (Interactive edit buffer content can't be verified without a TTY)

        # Empty string
        assertNothing(Linenoise::preload_buffer(""));

        # Whitespace (typical auto-indent use case)
        assertNothing(Linenoise::preload_buffer("    "));

        # Multiple indent levels
        assertNothing(Linenoise::preload_buffer("        "));

        # Regular text
        assertNothing(Linenoise::preload_buffer("some text"));

        # Text with special characters
        assertNothing(Linenoise::preload_buffer("hello\tworld"));

        # Calling preload_buffer multiple times (last one wins)
        assertNothing(Linenoise::preload_buffer("first"));
        assertNothing(Linenoise::preload_buffer("second"));
    }

    # ==================== Mask Mode Tests ====================

    testSetMaskMode() {
        resetHistory();
        # Enable mask mode - should not throw
        assertNothing(Linenoise::set_mask_mode(True));
        # Disable mask mode - should not throw
        assertNothing(Linenoise::set_mask_mode(False));
    }

    testSetMaskModeToggle() {
        resetHistory();
        # Toggle mask mode multiple times
        assertNothing(Linenoise::set_mask_mode(True));
        assertNothing(Linenoise::set_mask_mode(True));   # idempotent enable
        assertNothing(Linenoise::set_mask_mode(False));
        assertNothing(Linenoise::set_mask_mode(False));  # idempotent disable
        assertNothing(Linenoise::set_mask_mode(True));
        assertNothing(Linenoise::set_mask_mode(False));
    }

    # ==================== Auto-Dedent Tests ====================

    testSetAutoDedent() {
        resetHistory();
        # Basic configuration
        assertNothing(Linenoise::set_auto_dedent("    ", "}"));

        # Reconfigure with different settings
        assertNothing(Linenoise::set_auto_dedent("\t", ")"));

        # Empty indent string (effectively disables)
        assertNothing(Linenoise::set_auto_dedent("", "}"));

        # Single-char indent
        assertNothing(Linenoise::set_auto_dedent(" ", "]"));

        # UTF-8 dedent character
        assertNothing(Linenoise::set_auto_dedent("    ", "\u00bb"));
    }

    # ==================== Completion Enhancement Tests ====================

    testSetMenuComplete() {
        resetHistory();
        assertNothing(Linenoise::set_menu_complete(True));
        assertNothing(Linenoise::set_menu_complete(False));
    }

    testSetCompletionCaseInsensitive() {
        resetHistory();
        assertNothing(Linenoise::set_completion_case_insensitive(True));
        assertNothing(Linenoise::set_completion_case_insensitive(False));
    }

    testSetFilenameCompletion() {
        resetHistory();
        assertNothing(Linenoise::set_filename_completion(True));
        assertNothing(Linenoise::set_filename_completion(False));
    }

    # ==================== Timeout Tests ====================

    testLineWithTimeoutApi() {
        resetHistory();
        # line_with_timeout() requires a TTY for actual line reading.
        # Verify the function is accessible by getting a reference to it.
        code ref = \Linenoise::line_with_timeout();
        assertEq(Type::CallReference, ref.type());
    }

    testLineWithTimeoutValidation() {
        resetHistory();
        # Zero timeout should throw
        assertThrows("LINENOISE-TIMEOUT-ERROR", sub () {
            Linenoise::line_with_timeout("prompt> ", 0);
        });
        # Negative timeout should throw
        assertThrows("LINENOISE-TIMEOUT-ERROR", sub () {
            Linenoise::line_with_timeout("prompt> ", -1000);
        });
    }

    # ==================== Negative Tests ====================

    testSetMaxLenZero() {
        resetHistory();
        int result = Linenoise::history_set_max_len(0);
        # Should return 0 (failure) for invalid length
        assertEq(0, result);
    }

    testSetMaxLenNegative() {
        resetHistory();
        int result = Linenoise::history_set_max_len(-5);
        # Should return 0 (failure) for invalid length
        assertEq(0, result);
    }

    # ==================== Corner Cases ====================

    testHistorySpecialChars() {
        resetHistory();
        # Test with special shell characters
        string special = "echo 'hello' | grep \"world\" && ls -la > /dev/null 2>&1 &";
        Linenoise::history_add(special);

        list<auto> h = Linenoise::history();
        assertEq(special, h[0]);

        # Test with backslashes
        string backslash = "path\\to\\file";
        Linenoise::history_add(backslash);
        h = Linenoise::history();
        assertEq(backslash, h[1]);

        # Test with null-like strings (not actual nulls, which would truncate)
        string nullish = "before\\0after";
        Linenoise::history_add(nullish);
        h = Linenoise::history();
        assertEq(nullish, h[2]);
    }

    testHistoryLongLines() {
        resetHistory();
        # Test with very long line (near LINENOISE_MAX_LINE = 4096)
        string long_line = strmul("a", 4000);
        Linenoise::history_add(long_line);

        list<auto> h = Linenoise::history();
        assertEq(1, h.size());
        assertEq(4000, h[0].length());
    }

    testMaxLenChangeTruncates() {
        resetHistory();
        Linenoise::history_set_max_len(10);

        for (int i = 0; i < 10; i++) {
            Linenoise::history_add(sprintf("line%d", i));
        }

        list<auto> h = Linenoise::history();
        assertEq(10, h.size());

        # Reduce max length - should truncate oldest entries, keep newest 5
        Linenoise::history_set_max_len(5);
        h = Linenoise::history();
        assertEq(5, h.size());
        assertEq("line5", h[0]);
        assertEq("line6", h[1]);
        assertEq("line7", h[2]);
        assertEq("line8", h[3]);
        assertEq("line9", h[4]);

        # Truncate to 1
        Linenoise::history_set_max_len(1);
        h = Linenoise::history();
        assertEq(1, h.size());
        assertEq("line9", h[0]);

        # Expand max length - should not add phantom entries
        Linenoise::history_set_max_len(100);
        h = Linenoise::history();
        assertEq(1, h.size());
        assertEq("line9", h[0]);
    }

    testSetSyntaxCallback() {
        # Set a syntax callback using external helper
        assertNothing(Linenoise::set_syntax_callback(\dummySyntaxCallback()));

        # Replace with a different callback
        assertNothing(Linenoise::set_syntax_callback(\dummySyntaxCallback2()));

        # Clear the callback with NOTHING
        assertNothing(Linenoise::set_syntax_callback());
    }

    testBindKey() {
        # Bind and unbind ctrl key
        assertNothing(Linenoise::bind_key("ctrl-g", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("ctrl-g"));

        # Meta key
        assertNothing(Linenoise::bind_key("meta-d", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("meta-d"));

        # Ctrl + special key
        assertNothing(Linenoise::bind_key("ctrl-left", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("ctrl-left"));

        # Alt alias for meta
        assertNothing(Linenoise::bind_key("alt-f", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("alt-f"));

        # Named special keys
        assertNothing(Linenoise::bind_key("home", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("home"));

        assertNothing(Linenoise::bind_key("delete", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("delete"));

        assertNothing(Linenoise::bind_key("pageup", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("pageup"));

        # Single character key
        assertNothing(Linenoise::bind_key("x", \dummyKeyBindingCallback()));
        assertNothing(Linenoise::unbind_key("x"));

        # Unbinding a key that was never bound (should not throw)
        assertNothing(Linenoise::unbind_key("ctrl-g"));
    }

    testBindKeyReplace() {
        # Bind a key with one callback, then replace with another
        assertNothing(Linenoise::bind_key("ctrl-g", \dummyKeyBindingCallback()));
        # Replacing an existing binding should not throw or leak
        assertNothing(Linenoise::bind_key("ctrl-g", \dummyKeyBindingCallback2()));
        assertNothing(Linenoise::unbind_key("ctrl-g"));
    }

    testBindKeyInvalidSpec() {
        # Invalid key spec should throw
        assertThrows("LINENOISE-KEY-SPEC-ERROR", sub () {
            Linenoise::bind_key("invalid-key-name", \dummyKeyBindingCallback());
        });

        # Multi-word invalid key
        assertThrows("LINENOISE-KEY-SPEC-ERROR", sub () {
            Linenoise::bind_key("ctrl-not-a-key", \dummyKeyBindingCallback());
        });
    }

    testUnbindKeyInvalidSpec() {
        # Invalid key spec should throw
        assertThrows("LINENOISE-KEY-SPEC-ERROR", sub () {
            Linenoise::unbind_key("invalid-key-name");
        });
    }

    testSetRightPrompt() {
        # Set a right prompt
        assertNothing(Linenoise::set_right_prompt("[ins]"));

        # Replace with different content
        assertNothing(Linenoise::set_right_prompt("mode: normal"));

        # UTF-8 content
        assertNothing(Linenoise::set_right_prompt("\u2713 ok"));

        # Clear by passing NOTHING
        assertNothing(Linenoise::set_right_prompt());

        # Clear by passing empty string
        assertNothing(Linenoise::set_right_prompt(""));
    }

    testMultipleSaveLoadCycles() {
        resetHistory();
        string filename = tmp_dir + "/history_cycles.txt";

        # First cycle
        Linenoise::history_add("cycle1_line1");
        Linenoise::history_add("cycle1_line2");
        Linenoise::history_save(filename);

        # Second cycle - load and add more
        Linenoise::history_free();
        Linenoise::history_load(filename);
        Linenoise::history_add("cycle2_line1");
        Linenoise::history_save(filename);

        # Third cycle - verify all data
        Linenoise::history_free();
        Linenoise::history_load(filename);

        list<auto> h = Linenoise::history();
        assertEq(3, h.size());
        assertEq("cycle1_line1", h[0]);
        assertEq("cycle1_line2", h[1]);
        assertEq("cycle2_line1", h[2]);

        unlink(filename);
    }
}

