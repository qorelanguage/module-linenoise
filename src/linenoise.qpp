QoreClass* initAbstractHistoryProviderClass(QoreNamespace& ns);

/** @mainpage %Qore %Linenoise Module

    @tableofcontents

    @section linenoiseintro linenoise Module Introduction

    The linenoise module provides readline-like functionality to Qore, allowing
    qore programs to manage comfortable user input in the command line.

    This module is released under a choice of two licenses:

    - LGPL 2.1
    - MIT (see COPYING.MIT in the source distribution for more information)

    The module is tagged as such in the module's header (meaning it can be
    loaded unconditionally regardless of how the Qore library was initialized).

    The underlying functionality is provided by Linenoise-NG library: https://github.com/arangodb/linenoise-ng
    of the original version https://github.com/antirez/linenoise

    @section basic_usage Basic Usage

    The core of functionality is the Qore::Linenoise::line() function. It waits for user input
    providing basic and advanced edit functionality.

    @code{.py}
%new-style
%require-types
%strict-args

%requires linenoise

while (True) {
    *string line = Linenoise::line("prompt> ");
    if (!exists line) {
        printf("^C signal caught. Exiting.\n");
        break;
    }

    # process the line value...
}
    @endcode

    @section history_handling History Handling

    Linenoise module keeps history in its internal structure. To add a history item
    use @ref Qore::Linenoise::history_add()

    Full history content can be obtained with @ref Qore::Linenoise::history

    To handle history size use @ref Qore::Linenoise::history_set_max_len and
    @ref Qore::Linenoise::history_get_max_len

    History is not persistent across processes (the memory is cleared when the process terminates).
    To store and load history content use @ref Qore::Linenoise::history_save()
    and @ref Qore::Linenoise::history_load()

    @section line_completion Line Completion

    Users start line completion by pressing the TAB key when in @ref Qore::Linenoise::line().

    An callback has to be used to provide line completion values.
    The callback is registered with @ref Qore::Linenoise::set_callback().

    @note The callback code must accept a \c string as an input argument and return a \c list.

    If the input argument isn't a string, a \c RUNTIME-OVERLOAD-ERROR exception will be thrown.

    If the return value isn't a list, the return will be ignored.

    Non string members of returned list will be converted to string (string representation
    of the list member will be used).

    <b>Example</b>
    @code{.py}
# h<TAB> is expanded to string: history
list sub my_callback(string value) {
    list ret = ();
    if (value == 'h')
        push ret, 'history';

    return ret;
}

Linenoise::set_callback(\my_callback());
    @endcode

    @section key_shortcuts Keyboard Shortcuts

    @subsection movement_shortcuts Movement

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Left</td><td>\c Ctrl+B</td><td>move by one char left</td></tr>
    <tr><td>\c Right</td><td>\c Ctrl+F</td><td>move by one char right</td></tr>
    <tr><td>\c Meta+B</td><td>\c Ctrl+Left</td><td>move left by one word</td></tr>
    <tr><td>\c Meta+F</td><td>\c Ctrl+Right</td><td>move right by one word</td></tr>
    <tr><td>\c Home</td><td>\c Ctrl+A</td><td>go to the start of the line</td></tr>
    <tr><td>\c End</td><td>\c Ctrl+E</td><td>go to the end of the line</td></tr>
    </table>

    @subsection editing_shortcuts Editing

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Enter</td><td>\c Return</td><td>submit the user input</td></tr>
    <tr><td>\c Tab</td><td>&nbsp;</td><td>starts a code completion if the callback is defined, @ref line_completion</td></tr>
    <tr><td>\c Backspace</td><td>\c Ctrl+H</td><td>delete one char before cursor</td></tr>
    <tr><td>\c DEL</td><td>\c Delete</td><td>delete character under cursor</td></tr>
    <tr><td>\c Ctrl+D</td><td>&nbsp;</td><td>like Ctrl+C when there is no user content in edit buffer, otherwise like DEL</td></tr>
    <tr><td>\c Ctrl+T</td><td>&nbsp;</td><td>if cursor is at end, transpose the previous two chars</td></tr>
    <tr><td>\c Ctrl+V</td><td>&nbsp;</td><td>insert next character literally (bypasses special key handling)</td></tr>
    <tr><td>\c Ctrl+L</td><td>&nbsp;</td><td>clear screen and redisplay line</td></tr>
    <tr><td>\c Insert</td><td>&nbsp;</td><td>toggle between insert and overwrite mode (cursor shape changes to indicate mode)</td></tr>
    <tr><td>\c Ctrl+_</td><td>&nbsp;</td><td>undo last edit operation (consecutive character inserts are grouped)</td></tr>
    </table>

    @subsection kill_shortcuts Kill and Yank (Cut and Paste)

    Linenoise maintains a <b>kill ring</b> of up to 10 entries. Consecutive kill operations
    (without any intervening non-kill keystrokes) are appended together into a single kill ring
    entry, making it easy to kill several words and yank them back as one unit.

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Ctrl+K</td><td>&nbsp;</td><td>kill (cut) from cursor to end of line, save to kill ring</td></tr>
    <tr><td>\c Ctrl+U</td><td>&nbsp;</td><td>kill (cut) from cursor to beginning of line, save to kill ring</td></tr>
    <tr><td>\c Ctrl+W</td><td>&nbsp;</td><td>kill word to the left of cursor (to whitespace), save to kill ring</td></tr>
    <tr><td>\c Meta+D</td><td>&nbsp;</td><td>kill word to the right of cursor, save to kill ring</td></tr>
    <tr><td>\c Meta+Backspace</td><td>&nbsp;</td><td>kill word to the left of cursor (alphanumeric boundary), save to kill ring</td></tr>
    <tr><td>\c Ctrl+Y</td><td>&nbsp;</td><td>yank (paste) the most recent kill ring entry at cursor position</td></tr>
    <tr><td>\c Meta+Y</td><td>&nbsp;</td><td>after Ctrl+Y, cycle through older kill ring entries (yank-pop)</td></tr>
    </table>

    @subsection case_shortcuts Word Case Changes

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Meta+U</td><td>&nbsp;</td><td>uppercase the word at cursor</td></tr>
    <tr><td>\c Meta+L</td><td>&nbsp;</td><td>lowercase the word at cursor</td></tr>
    <tr><td>\c Meta+C</td><td>&nbsp;</td><td>capitalize the word at cursor (initial cap, rest lowercase)</td></tr>
    </table>

    @subsection history_shortcuts History Navigation

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Up</td><td>\c Ctrl+P</td><td>recall previous (older) history entry</td></tr>
    <tr><td>\c Down</td><td>\c Ctrl+N</td><td>recall next (newer) history entry</td></tr>
    <tr><td>\c PgUp</td><td>\c Meta+&lt;</td><td>jump to beginning (oldest entry) of history</td></tr>
    <tr><td>\c PgDown</td><td>\c Meta+&gt;</td><td>jump to end (newest entry) of history</td></tr>
    <tr><td>\c Ctrl+R</td><td>&nbsp;</td><td>reverse incremental history search; see @ref find_key_shortcut</td></tr>
    <tr><td>\c Ctrl+S</td><td>&nbsp;</td><td>forward incremental history search; see @ref find_key_shortcut</td></tr>
    </table>

    @subsection signal_shortcuts Signals

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Ctrl+C</td><td>&nbsp;</td><td>keyboard interrupt, @ref nothing "NOTHING" is returned from Qore::Linenoise::line() call</td></tr>
    <tr><td>\c Ctrl+Z</td><td>&nbsp;</td><td>suspend to shell (Unix only; resumes when foregrounded)</td></tr>
    </table>

    @subsection macro_shortcuts Keyboard Macros

    Keyboard macros allow you to record a sequence of keystrokes and replay them.

    <table>
    <tr><th>Shortcut</th><th>Description</th></tr>
    <tr><td>\c Ctrl+X&nbsp;\c (</td><td>begin recording a keyboard macro</td></tr>
    <tr><td>\c Ctrl+X&nbsp;\c )</td><td>stop recording the keyboard macro</td></tr>
    <tr><td>\c Ctrl+X&nbsp;\c e</td><td>execute (replay) the last recorded keyboard macro</td></tr>
    </table>

    While recording, all keystrokes (including editing, movement, kill/yank, etc.) are captured.
    The macro control keys themselves (Ctrl+X (, Ctrl+X ), Ctrl+X e) are not recorded.
    Recording a new macro replaces the previous one.

    @subsection find_key_shortcut Search Keyboard Shortcuts

    These shortcuts are valid in incremental search (\c Ctrl+R / \c Ctrl+S) mode

    <table>
    <tr><th>Shortcut</th><th>Alternative</th><th>Description</th></tr>
    <tr><td>\c Delete</td><td>\c Ctrl+H</td><td>delete, return to normal operation mode if the line is empty</td></tr>
    <tr><td>\c Up</td><td>\c Ctrl+P</td><td>search for the previous (earlier) match</td></tr>
    <tr><td>\c Down</td><td>\c Ctrl+N</td><td>search for the next (later) match</td></tr>
    <tr><td>\c Ctrl+G</td><td>\c Ctrl+C</td><td>terminates the search with no effect</td></tr>
    <tr><td>\c Ctrl+J</td><td>&nbsp;</td><td>terminates the search leaving the buffer in place</td></tr>
    </table>

    @section async_api Async (Non-Blocking) Line Editing API

    The async API enables integration with external event loops (e.g., ncurses, select/poll).
    Instead of blocking in @ref Qore::Linenoise::line(), you create a session, feed individual
    bytes as they arrive, and check the return code to detect when a line is complete.

    <b>Basic event-loop integration example:</b>
    @code{.py}
%modern

%requires linenoise
%requires Util

# Start an async editing session
int sid = Linenoise::edit_start("prompt> ");

# Get the file descriptor to monitor
int fd = Linenoise::edit_fd(sid);

# Event loop: read one byte at a time and feed to the editor
while (True) {
    # In a real application, use select/poll on fd to wait for input
    # For simplicity, we read directly here
    *binary b = stdin.read(1, 100);
    if (!exists b || !b.size()) {
        continue;
    }

    int rv = Linenoise::edit_feed(sid, b[0]);
    if (rv == 0) {
        # LN_FEED_MORE: need more input, continue the loop
        continue;
    }
    if (rv == 1) {
        # LN_FEED_DONE: line accepted (Enter pressed)
        *string line = Linenoise::edit_get_line(sid);
        printf("Got line: %y\n", line);
        break;
    }
    if (rv == -1) {
        # LN_FEED_ABORT: Ctrl+C pressed
        printf("Aborted (key_type=%d)\n", Linenoise::edit_key_type(sid));
        break;
    }
    if (rv == -2) {
        # LN_FEED_EXIT: Ctrl+D on empty line
        printf("Exit\n");
        break;
    }
}

Linenoise::edit_stop(sid);
    @endcode

    For external rendering (e.g., ncurses), use @ref Qore::Linenoise::edit_set_silent() to
    suppress terminal output and @ref Qore::Linenoise::edit_get_buffer() to read the buffer
    state for custom rendering:

    @code{.py}
int sid = Linenoise::edit_start("prompt> ");
Linenoise::edit_set_silent(sid, True);

# After feeding bytes, inspect the buffer for external rendering:
hash<auto> buf = Linenoise::edit_get_buffer(sid);
# buf.text   = current buffer contents (string)
# buf.cursor = cursor position in characters (int)
# buf.len    = buffer length in characters (int)

# Render buf.text in your UI, positioning cursor at buf.cursor

Linenoise::edit_stop(sid);
    @endcode

    @note The async API currently supports basic editing operations (character insert, delete,
    movement, kill/yank, transpose, clear screen) and common escape sequences (arrow keys,
    Home/End, Delete, Ctrl+Left/Right). History navigation (Up/Down) is not yet supported in
    async mode and will beep. Tab completion, incremental search, and bracketed paste are
    available only through the blocking @ref Qore::Linenoise::line() API.

    @section linenoisereleasenotes linenoise Module Release Notes

    @subsection linenoise_1_2_0 linenoise Module Version 1.2.0
    - added @ref Qore::Linenoise::AbstractHistoryProvider abstract class for
      external history management; allows an external history manager (e.g., QoreHistory)
      to control Up/Down arrow navigation and Ctrl+R/S incremental search, eliminating
      the need to dual-track history between linenoise and a higher-level history system
    - added @ref Qore::Linenoise::set_history_provider() to register an
      @ref Qore::Linenoise::AbstractHistoryProvider "AbstractHistoryProvider" instance
    - when a history provider is set, the internal history array is bypassed for
      navigation; @ref Qore::Linenoise::history_add(), @ref Qore::Linenoise::history(),
      and other internal history functions continue to work independently
    - @note when a history provider is set, @c Meta+< and @c Meta+> (jump to
      oldest/newest history entry) and @c Page @c Up / @c Page @c Down are not supported
      and will beep, as the provider API does not expose a jump-to-boundary concept
    - added @ref Qore::Linenoise::set_syntax_callback() for real-time syntax highlighting
      via a user-provided callback that returns ANSI-colorized text; brace/bracket matching
      overlays the syntax colors for the matched character
    - added @ref Qore::Linenoise::set_right_prompt() for displaying a right-aligned prompt
      string in dim text at the right edge of the terminal
    - added undo system with @c Ctrl+_ to undo edit operations; consecutive character
      insertions are coalesced into single undo entries for efficient undoing
    - added @ref Qore::Linenoise::line_with_timeout() for reading input with a configurable
      timeout that throws @c LINENOISE-TIMEOUT-ERROR on expiration
    - added @ref Qore::Linenoise::set_menu_complete() for Tab-cycling through completions
      instead of displaying a list
    - added @ref Qore::Linenoise::set_completion_case_insensitive() for case-insensitive
      completion prefix matching
    - added @ref Qore::Linenoise::set_filename_completion() for built-in filesystem path
      completion when no user callback is registered
    - added overwrite/replace mode toggled by the Insert key with visual cursor shape feedback
      (bar cursor for insert mode, block cursor for overwrite mode)
    - added bracketed paste mode support: pasted text is inserted directly without triggering
      code completion, auto-dedent, or hints refresh
    - added @ref Qore::Linenoise::set_mask_mode() for password/sensitive data input that
      displays @c * characters instead of actual input
    - added @ref Qore::Linenoise::bind_key() and @ref Qore::Linenoise::unbind_key() for custom
      key binding callbacks; user bindings take priority over built-in key handlers
    - added keyboard macro support with Ctrl+X (, Ctrl+X ), and Ctrl+X e for recording and
      replaying keystroke sequences; see @ref macro_shortcuts
    - added async (non-blocking) line editing API for event-loop integration:
      @ref Qore::Linenoise::edit_start(), @ref Qore::Linenoise::edit_feed(),
      @ref Qore::Linenoise::edit_get_line(), @ref Qore::Linenoise::edit_stop(),
      @ref Qore::Linenoise::edit_fd(), @ref Qore::Linenoise::edit_get_buffer(),
      @ref Qore::Linenoise::edit_set_silent(), and @ref Qore::Linenoise::edit_key_type();
      enables byte-by-byte input processing with UTF-8 and escape sequence accumulation
      for integration with external event loops
    - added @ref Qore::Linenoise::set_hints_callback() for displaying inline hints
      (e.g., function signatures) after the cursor in dim text
    - added @ref Qore::Linenoise::set_auto_dedent() for automatic dedent when typing
      closing characters (e.g., @c }) on indented lines
    - added @ref Qore::Linenoise::preload_buffer() function to pre-fill the edit buffer for
      the next @ref Qore::Linenoise::line() call, enabling auto-indentation in REPL environments
    - added @c : to tab-completion break characters for namespace-qualified completions
      (e.g., @c Namespace::Class)
    - completion callback now receives the full line up to the cursor position for
      context-aware completions
    - refactored internal key handling to use a dispatch table for extensibility
    - expanded keyboard shortcuts documentation with previously undocumented keybindings:
      word movement (Meta+B/F), word deletion (Meta+D, Meta+Backspace), word case changes
      (Meta+U/L/C), yank-pop (Meta+Y), forward search (Ctrl+S), history jump (Meta+&lt;/&gt;),
      DEL key, and Ctrl+Z suspend
    - added kill ring documentation section
    - fixed memory leak in @ref Qore::Linenoise::history_set_max_len() where truncating
      history to a smaller size leaked the dropped (oldest) entry strings
    - fixed incorrect array offset in @ref Qore::Linenoise::history_set_max_len() that
      could copy wrong entries when the history wasn't full
    - added history cleanup in module destructor to prevent leaks at process exit
    - fixed memory leak in @ref Qore::Linenoise::history() where strings returned by
      \c linenoiseHistoryLine() were not freed

    @subsection linenoise_1_1_1 linenoise Module Version 1.1.1
    - fixed @ref Qore::Linenoise::columns() to use proper terminal detection via ioctl()
      instead of reading from environment variable
    - added @ref Qore::Linenoise::rows() function for terminal height detection
    - fixed thread safety issue in completion callback
    - improved exception handling in completion callback
    - fixed UTF-8 encoding for completion callback input
    - fixed bug in brace matching and word-break detection where certain Unicode
      characters could falsely match ASCII bracket/break characters due to truncation
      of char32_t values when passed to strchr()
    - added comprehensive test suite with UTF-8 tests

    @subsection linenoise_1_1_0 linenoise Module Version 1.1.0
    - updated to use the Linenoise-NG library to support UTF-8 characters

    @subsection linenoise_1_0_1 linenoise Module Version 1.0.1
    - updated to build with \c qpp from %Qore 1.12.4+

    @subsection linenoise_1_0_0 linenoise Module Version 1.0.0
    - initial release
*/

static QoreNamespace LinenoiseNS("Linenoise");

void init_linenoise_functions(QoreNamespace& ns);

QoreRecursiveThreadLock lock;
ResolvedCallReferenceNode* callbackNode = nullptr;
ResolvedCallReferenceNode* hintsCallbackNode = nullptr;
ResolvedCallReferenceNode* syntaxCallbackNode = nullptr;

// History provider object storage
static QoreObject* historyProviderObj = nullptr;
static HistoryProviderPriv* historyProviderPriv = nullptr;

// User key binding callback storage
static std::map<int, ResolvedCallReferenceNode*> keyBindingCallbacks;

// Async editing session management
static std::map<int64_t, linenoiseState*> activeSessions;
static int64_t nextSessionId = 1;

// Key code constants matching linenoise internal encoding
static const int LN_META = 0x1c000000;
static const int LN_CTRL = 0x0c000000;
static const int LN_LEFT_ARROW_KEY = 0x10200000;
static const int LN_RIGHT_ARROW_KEY = 0x10600000;
static const int LN_UP_ARROW_KEY = 0x10800000;
static const int LN_DOWN_ARROW_KEY = 0x10400000;
static const int LN_HOME_KEY = 0x10a00000;
static const int LN_END_KEY = 0x10c00000;
static const int LN_DELETE_KEY = 0x10e00000;
static const int LN_PAGE_UP_KEY = 0x11000000;
static const int LN_PAGE_DOWN_KEY = 0x11200000;
static const int LN_INSERT_KEY = 0x11400000;

// Parse a key specification string into an internal key code
// Formats: "ctrl-a", "meta-d", "ctrl-left", "meta-shift-d", "a", "space"
static int parseKeySpec(const char* spec, ExceptionSink* xsink) {
    std::string s(spec);
    // convert to lowercase for comparison
    for (auto& ch : s) {
        ch = tolower(ch);
    }

    int modifiers = 0;

    // Parse modifiers
    while (true) {
        if (s.substr(0, 5) == "ctrl-" || s.substr(0, 5) == "ctrl+") {
            modifiers |= LN_CTRL;
            s = s.substr(5);
        } else if (s.substr(0, 5) == "meta-" || s.substr(0, 5) == "meta+" ||
                   s.substr(0, 4) == "alt-" || s.substr(0, 4) == "alt+") {
            modifiers |= LN_META;
            s = s.substr(s[3] == '-' || s[3] == '+' ? 4 : 5);
        } else {
            break;
        }
    }

    // Parse the key name
    int keyCode = 0;
    if (s == "left") {
        keyCode = LN_LEFT_ARROW_KEY;
    } else if (s == "right") {
        keyCode = LN_RIGHT_ARROW_KEY;
    } else if (s == "up") {
        keyCode = LN_UP_ARROW_KEY;
    } else if (s == "down") {
        keyCode = LN_DOWN_ARROW_KEY;
    } else if (s == "home") {
        keyCode = LN_HOME_KEY;
    } else if (s == "end") {
        keyCode = LN_END_KEY;
    } else if (s == "delete" || s == "del") {
        keyCode = LN_DELETE_KEY;
    } else if (s == "pageup" || s == "pgup") {
        keyCode = LN_PAGE_UP_KEY;
    } else if (s == "pagedown" || s == "pgdown") {
        keyCode = LN_PAGE_DOWN_KEY;
    } else if (s == "insert" || s == "ins") {
        keyCode = LN_INSERT_KEY;
    } else if (s == "space") {
        keyCode = ' ';
    } else if (s == "tab") {
        keyCode = 9;  // ctrl-I
    } else if (s == "return" || s == "enter") {
        keyCode = 13;  // ctrl-M
    } else if (s == "backspace") {
        keyCode = 8;  // ctrl-H
    } else if (s.length() == 1 && s[0] >= 'a' && s[0] <= 'z') {
        if (modifiers & LN_CTRL) {
            // ctrl-<char>: convert to control character (1-26)
            keyCode = s[0] - 'a' + 1;
            modifiers &= ~LN_CTRL;  // already encoded in keyCode
        } else {
            keyCode = s[0];
        }
    } else if (s.length() == 1) {
        keyCode = s[0];
    } else {
        if (xsink) {
            xsink->raiseException("LINENOISE-KEY-SPEC-ERROR",
                                  "invalid key specification: '%s'", spec);
        }
        return -1;
    }

    return keyCode | modifiers;
}

// C trampoline for user key bindings
static int qore_linenoise_user_key_cb(const char* line, int pos, char** new_line, int* new_pos, void* userData) {
    AutoLocker al(lock);

    ResolvedCallReferenceNode* cb = static_cast<ResolvedCallReferenceNode*>(userData);
    if (!cb) {
        return 0;
    }

    ExceptionSink xsink;

    // Create hash argument: {line: string, pos: int}
    ReferenceHolder<QoreHashNode> arg(new QoreHashNode(autoTypeInfo), &xsink);
    arg->setKeyValue("line", new QoreStringNode(line, QCS_UTF8), &xsink);
    arg->setKeyValue("pos", pos, &xsink);

    ValueHolder ret(&xsink);
    {
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
        args->push(arg.release(), nullptr);
        ret = cb->execValue(*args, &xsink);
    }

    if (xsink.isException()) {
        // Log exception info to stderr so it's not completely silent
        xsink.handleExceptions();
        return 0;
    }

    // If callback returns a hash, update the buffer via out params
    if (ret->getType() == NT_HASH) {
        QoreHashNode* h = ret->get<QoreHashNode>();
        QoreValue lineVal = h->getKeyValue("line");
        QoreValue posVal = h->getKeyValue("pos");
        if (lineVal.getType() == NT_STRING) {
            QoreStringNode* newLine = lineVal.get<QoreStringNode>();
            *new_line = strdup(newLine->c_str());
        }
        if (posVal.getType() == NT_INT) {
            *new_pos = static_cast<int>(posVal.getAsBigInt());
        }
    }

    return 0;
}

void qore_linenoise_completion_cb(const char *input, linenoiseCompletions *lc) {
    AutoLocker al(lock);

    if (!callbackNode) {
        return;
    }

    ExceptionSink xsink;

    ValueHolder ret(&xsink);
    {
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
        args->push(new QoreStringNode(input, QCS_UTF8), nullptr);
        ret = callbackNode->execValue(*args, &xsink);
    }

    // Check for exceptions from callback execution
    if (xsink.isException()) {
        // Log the exception but don't crash - completion just won't work
        xsink.clear();
        return;
    }

    if (ret->getType() != NT_LIST) {
        // Callback didn't return a list - silently ignore
        return;
    }

    QoreListNode* lst = ret->get<QoreListNode>();
    for (size_t i = 0; i < lst->size(); ++i) {
        QoreStringValueHelper str(lst->retrieveEntry(i));
        linenoiseAddCompletion(lc, str->c_str());
    }
}

char* qore_linenoise_hints_cb(const char* input, int* color, int* bold) {
    AutoLocker al(lock);

    if (!hintsCallbackNode) {
        return NULL;
    }

    ExceptionSink xsink;

    ValueHolder ret(&xsink);
    {
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
        args->push(new QoreStringNode(input, QCS_UTF8), nullptr);
        ret = hintsCallbackNode->execValue(*args, &xsink);
    }

    if (xsink.isException()) {
        xsink.clear();
        return NULL;
    }

    if (ret->getType() == NT_STRING) {
        // Return plain string hint with default color (dark grey)
        *color = 90;  // bright black (dark grey)
        *bold = 0;
        QoreStringNode* str = ret->get<QoreStringNode>();
        return strdup(str->c_str());
    }

    if (ret->getType() == NT_HASH) {
        // Hash with {text, color, bold} keys
        QoreHashNode* h = ret->get<QoreHashNode>();
        QoreValue text = h->getKeyValue("text");
        if (text.getType() != NT_STRING) {
            return NULL;
        }
        QoreValue c = h->getKeyValue("color");
        *color = c.getType() == NT_INT ? (int)c.getAsBigInt() : 90;
        QoreValue b = h->getKeyValue("bold");
        *bold = b.getAsBool() ? 1 : 0;
        return strdup(text.get<QoreStringNode>()->c_str());
    }

    return NULL;
}

void qore_linenoise_free_hints_cb(void* hint) {
    free(hint);
}

char* qore_linenoise_syntax_cb(const char* buf) {
    AutoLocker al(lock);

    if (!syntaxCallbackNode) {
        return NULL;
    }

    ExceptionSink xsink;

    ValueHolder ret(&xsink);
    {
        ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), &xsink);
        args->push(new QoreStringNode(buf, QCS_UTF8), nullptr);
        ret = syntaxCallbackNode->execValue(*args, &xsink);
    }

    if (xsink.isException()) {
        xsink.clear();
        return NULL;
    }

    if (ret->getType() == NT_STRING) {
        QoreStringNode* str = ret->get<QoreStringNode>();
        return strdup(str->c_str());
    }

    return NULL;
}

// History provider C trampolines
static char* qore_history_provider_prev_cb(const char* prefix, void* userData) {
    AutoLocker al(lock);
    if (!historyProviderPriv) {
        return NULL;
    }
    ExceptionSink xsink;
    char* rv = historyProviderPriv->callPrev(prefix, &xsink);
    if (xsink.isException()) {
        xsink.handleExceptions();
        return NULL;
    }
    return rv;
}

static char* qore_history_provider_next_cb(const char* prefix, void* userData) {
    AutoLocker al(lock);
    if (!historyProviderPriv) {
        return NULL;
    }
    ExceptionSink xsink;
    char* rv = historyProviderPriv->callNext(prefix, &xsink);
    if (xsink.isException()) {
        xsink.handleExceptions();
        return NULL;
    }
    return rv;
}

static void qore_history_provider_reset_cb(void* userData) {
    AutoLocker al(lock);
    if (!historyProviderPriv) {
        return;
    }
    ExceptionSink xsink;
    historyProviderPriv->callReset(&xsink);
    if (xsink.isException()) {
        xsink.handleExceptions();
    }
}

static char* qore_history_provider_search_cb(const char* pattern, int direction, void* userData) {
    AutoLocker al(lock);
    if (!historyProviderPriv) {
        return NULL;
    }
    ExceptionSink xsink;
    char* rv = historyProviderPriv->callSearch(pattern, direction, &xsink);
    if (xsink.isException()) {
        xsink.handleExceptions();
        return NULL;
    }
    return rv;
}

static void linenoise_module_init(QoreModuleInitContext& ctx, ExceptionSink& xsink) {
    LinenoiseNS.addSystemClass(initAbstractHistoryProviderClass(LinenoiseNS));
    init_linenoise_functions(LinenoiseNS);

    linenoiseSetCompletionCallback(qore_linenoise_completion_cb);
    linenoiseSetHintsCallback(qore_linenoise_hints_cb);
    linenoiseSetFreeHintsCallback(qore_linenoise_free_hints_cb);
    linenoiseSetSyntaxCallback(qore_linenoise_syntax_cb);
    linenoiseSetUserKeyCallback(qore_linenoise_user_key_cb);
}

static void linenoise_module_ns_init(QoreNamespace* rns, QoreNamespace* qns, ExceptionSink& xsink) {
    qns->addNamespace(LinenoiseNS.copy());
}

static void linenoise_module_delete() {
    ExceptionSink xsink;
    if (callbackNode) {
        callbackNode->deref(&xsink);
    }
    if (hintsCallbackNode) {
        hintsCallbackNode->deref(&xsink);
    }
    if (syntaxCallbackNode) {
        syntaxCallbackNode->deref(&xsink);
    }
    if (historyProviderPriv) {
        historyProviderPriv->deref(&xsink);
        historyProviderPriv = nullptr;
    }
    if (historyProviderObj) {
        historyProviderObj->deref(&xsink);
        historyProviderObj = nullptr;
    }
    for (auto& kv : keyBindingCallbacks) {
        if (kv.second) {
            kv.second->deref(&xsink);
        }
    }
    keyBindingCallbacks.clear();
    for (auto& kv : activeSessions) {
        if (kv.second) {
            linenoiseEditStop(kv.second);
        }
    }
    activeSessions.clear();
    linenoiseHistoryFree();
}

static void linenoise_module_init(QoreModuleInitContext& ctx, ExceptionSink& xsink);
static void linenoise_module_ns_init(QoreNamespace* rns, QoreNamespace* qns, ExceptionSink& xsink);
static void linenoise_module_delete();

extern "C" DLLEXPORT void linenoise_qore_module_desc(QoreModuleInfo& mod_info) {
    mod_info.name = "linenoise";
    mod_info.version = PACKAGE_VERSION;
    mod_info.desc = "Linenoise module";
    mod_info.author = "Petr Vanek";
    mod_info.url = "http://qore.org";
    mod_info.api_major = QORE_MODULE_API_MAJOR;
    mod_info.api_minor = QORE_MODULE_API_MINOR;
    mod_info.init = linenoise_module_init;
    mod_info.ns_init = linenoise_module_ns_init;
    mod_info.del = linenoise_module_delete;
    mod_info.license = QL_LGPL;
    mod_info.license_str = "LGPL";
}

/** @defgroup linenoise_functions Linenoise Functions
 */
///@{
namespace Qore::Linenoise;

//! Main function to obtain line value
/**
    The function waits for user input confirmed by Enter.

    @param prompt a custom string with prompt
    @return User input string or @ref Qore::NOTHING if the user sends ^C (Ctrl+C) interrupt signal

    <b>Features:</b>
    - accept basic user input: regular characters, cursor keys, TAB, ENTER keys
    - accept advanced edits: Ctrl+key, @ref key_shortcuts
    - waits until the ENTER is pressed

    <b>Example:</b>
    @code{.py}
while (True) {
    *string line = line("my prompt> ");
    printf("echo: %s\n", line);
}
    @endcode

    @see @ref basic_usage
 */
string line(string prompt) {
    AutoLocker al(lock);

    char * ret = linenoise(prompt->c_str());
    if (ret) {
        QoreStringNode *s = new QoreStringNode(ret);
        free(ret);
        return s;
    } else {
        return nothing();
    }
}

//! Add string to history
/**
    It adds new item to history. The history queue is shifted
    if it hits the maximum history size.

    @param line a string to be added
 */
int history_add(string line) {
    AutoLocker al(lock);

    return linenoiseHistoryAdd(line->c_str());
}

//! Set size of the history
/**
    @param len a new size
 */
int history_set_max_len(int len) {
    AutoLocker al(lock);

    return linenoiseHistorySetMaxLen(len);
}

//! get size of the history
/**
    @return int with size of history
 */
int history_get_max_len() {
    AutoLocker al(lock);

    return linenoiseHistoryGetMaxLen();
}

//! Save history to file
/**
    Save history queue to plain-text file.

    @param filename a filename with relative or full path

    @throw LINENOISE-HISTORY-SAVE-ERROR
 */
nothing history_save(string filename) [dom=FILESYSTEM] {
    AutoLocker al(lock);

    if (linenoiseHistorySave(filename->c_str())) {
        xsink->raiseException("LINENOISE-HISTORY-SAVE-ERROR",
                              "error: %d; description: %s", errno, strerror(errno));
    }
}

//! Load history from file
/**
    Load history queue from plain-text file.

    @param filename a filename with relative or full path

    @throw LINENOISE-HISTORY-LOAD-ERROR
 */
nothing history_load(string filename) [dom=FILESYSTEM] {
    AutoLocker al(lock);

    if (linenoiseHistoryLoad(filename->c_str())) {
        xsink->raiseException("LINENOISE-HISTORY-LOAD-ERROR",
                              "error: %d; description: %s", errno, strerror(errno));
    }
}

//! Clear the history
nothing history_free() {
    AutoLocker al(lock);

    linenoiseHistoryFree();
}

//! Get complete history
/**
    Get complete history. History structure is limited by @ref Qore::Linenoise::history_set_max_len()

    @return list a list with histroy items. 0 index is the oldest.

    @see @ref history_handling
 */
list<auto> history() {
    ReferenceHolder<QoreListNode> ret(new QoreListNode(autoTypeInfo), xsink);

    AutoLocker al(lock);
    int index = 0;
    while (true) {
        char* data = linenoiseHistoryLine(index++);
        if (!data) {
            break;
        }
        ON_BLOCK_EXIT(free, data);
        ret->push(new QoreStringNode(data, QCS_UTF8), xsink);
    }

    return ret.release();
}

//! Get terminal width in characters.
/**
    @return int actual width of terminal window in characters (defaults to 80 if detection fails)
 */
int columns() {
    return linenoiseColumns();
}

//! Get terminal height in rows.
/**
    @return int actual height of terminal window in rows (defaults to 24 if detection fails)
 */
int rows() {
    return linenoiseRows();
}

//! Set auto-completion callback function
/**
    @param code a function/method reference or a closure to handle completion callback

    @see @ref line_completion

    @warning Qore language does not support complex types yet so you can register
             any code with this function. But if the function/code will not accept
             the string argument the \c RUNTIME-OVERLOAD-ERROR exception will be
             thrown
 */
nothing set_callback(code callback) {
    AutoLocker al(lock);

    if (callbackNode) {
        callbackNode->deref(xsink);
    }
    callbackNode = callback->refRefSelf();
}

//! Pre-fill the edit buffer for the next line() call
/**
    Sets text that will appear as editable content when @ref Qore::Linenoise::line() is next called.
    The user can edit or delete this pre-filled text using normal editing keys (backspace, etc.).

    This is useful for auto-indentation in REPL environments: before reading a continuation line,
    call this function with the appropriate whitespace to pre-fill the indent.

    @param text The text to pre-fill in the edit buffer

    @note The preloaded text is consumed by the next @ref Qore::Linenoise::line() call and does not
    persist beyond that single call.

    <b>Example:</b>
    @code{.py}
# Pre-fill 8 spaces of indentation
Linenoise::preload_buffer("        ");
*string line = Linenoise::line("...> ");
# The user sees "...>         " with cursor after the spaces
    @endcode

    @since linenoise 1.2.0
 */
nothing preload_buffer(string text) {
    AutoLocker al(lock);

    linenoisePreloadBuffer(text->c_str());
}

//! Configure auto-dedent behavior for closing characters
/**
    When the dedent character is typed and the edit buffer contains only
    whitespace (i.e., only auto-indentation), one indent level is removed
    before the character is inserted. This provides a seamless coding
    experience for block-structured languages.

    @param indent_str The indentation string (e.g., "    " for 4 spaces)
    @param dedent_char The character that triggers dedent (e.g., "}")

    @par Example
    @code{.py}
# Configure auto-dedent for Qore's brace-based blocks
Linenoise::set_auto_dedent("    ", "}");
# Now when user types "}" on an indented line, one level is removed automatically
    @endcode

    @since linenoise 1.2.0
 */
nothing set_auto_dedent(string indent_str, string dedent_char) {
    AutoLocker al(lock);

    char32_t dc = 0;
    if (dedent_char->strlen() > 0) {
        dc = static_cast<char32_t>(dedent_char->getUnicodePointFromUTF8(0));
    }
    linenoiseSetAutoDedent(indent_str->c_str(), dc);
}

//! Set hints callback function for inline argument display
/**
    @param callback a function/method reference or a closure to handle hints callback,
    or @ref nothing "NOTHING" to clear.
    The callback receives a string (the current input line) and should return one of:
    - a string: displayed as a dim grey hint after the cursor
    - a hash with keys: \c text (string), \c color (int ANSI color code), \c bold (bool)
    - @ref nothing "NOTHING": no hint displayed

    @par Example
    @code{.py}
Linenoise::set_hints_callback(sub (string input) {
    if (input == "printf(") {
        return " string fmt, ...";
    }
});
# Clear the hints callback
Linenoise::set_hints_callback();
    @endcode

    @since linenoise 1.2.0
 */
nothing set_hints_callback(*code callback) {
    AutoLocker al(lock);

    if (hintsCallbackNode) {
        hintsCallbackNode->deref(xsink);
    }
    if (callback) {
        hintsCallbackNode = callback->refRefSelf();
    } else {
        hintsCallbackNode = nullptr;
    }
}

//! Enable or disable mask (password) mode
/**
    When mask mode is enabled, all characters in the edit buffer are displayed
    as @c * asterisks instead of their actual values. This is useful for password
    input or other sensitive data entry.

    When mask mode is active:
    - All characters are displayed as @c *
    - Brace/bracket matching highlighting is disabled
    - Hints callback display is suppressed
    - The actual characters are still stored in the edit buffer and returned normally

    @param enable \c True to enable mask mode, \c False to disable

    @par Example
    @code{.py}
Linenoise::set_mask_mode(True);
*string password = Linenoise::line("Password: ");
Linenoise::set_mask_mode(False);
    @endcode

    @since linenoise 1.2.0
 */
nothing set_mask_mode(bool enable) {
    AutoLocker al(lock);

    if (enable) {
        linenoiseMaskModeEnable();
    } else {
        linenoiseMaskModeDisable();
    }
}

//! Enable or disable menu-complete mode
/**
    When menu-complete is enabled and multiple completions exist with no further
    common prefix, pressing Tab cycles through the completions one at a time
    instead of showing a list. Each subsequent Tab replaces the current word with
    the next completion. Pressing any other key accepts the current completion and
    processes that key normally.

    @param enable \c True to enable menu-complete, \c False for standard completion behavior

    @par Example
    @code{.py}
Linenoise::set_menu_complete(True);
    @endcode

    @since linenoise 1.2.0
 */
nothing set_menu_complete(bool enable) {
    AutoLocker al(lock);

    linenoiseSetMenuComplete(enable ? 1 : 0);
}

//! Enable or disable case-insensitive completion matching
/**
    When enabled, completion prefix matching ignores case differences. The
    displayed completions retain their original casing.

    @param enable \c True to enable case-insensitive matching, \c False for case-sensitive

    @par Example
    @code{.py}
Linenoise::set_completion_case_insensitive(True);
    @endcode

    @since linenoise 1.2.0
 */
nothing set_completion_case_insensitive(bool enable) {
    AutoLocker al(lock);

    linenoiseSetCompletionCaseInsensitive(enable ? 1 : 0);
}

//! Enable or disable built-in filename completion
/**
    When enabled and no user completion callback is registered (via
    @ref Qore::Linenoise::set_callback()), pressing Tab will complete filenames
    from the current directory. Directories are completed with a trailing @c /
    separator.

    @param enable \c True to enable filename completion, \c False to disable

    @par Example
    @code{.py}
Linenoise::set_filename_completion(True);
    @endcode

    @since linenoise 1.2.0
 */
nothing set_filename_completion(bool enable) [dom=FILESYSTEM] {
    AutoLocker al(lock);

    linenoiseSetFilenameCompletion(enable ? 1 : 0);
}

//! Read a line of input with a timeout
/**
    Like @ref Qore::Linenoise::line() but with a configurable timeout. If no input
    is received within the specified time, a \c LINENOISE-TIMEOUT-ERROR exception
    is thrown.

    @param prompt a custom string with prompt
    @param timeout_ms timeout in milliseconds; must be > 0

    @return User input string or @ref nothing "NOTHING" if the user sends ^C (Ctrl+C)

    @throw LINENOISE-TIMEOUT-ERROR thrown when the timeout expires before input is received

    @par Example
    @code{.py}
try {
    *string line = Linenoise::line_with_timeout("prompt> ", 30000);  # 30 second timeout
} catch (hash<ExceptionInfo> ex) {
    if (ex.err == "LINENOISE-TIMEOUT-ERROR") {
        printf("Input timed out\n");
    }
}
    @endcode

    @since linenoise 1.2.0
 */
*string line_with_timeout(string prompt, int timeout_ms) {
    if (timeout_ms <= 0) {
        xsink->raiseException("LINENOISE-TIMEOUT-ERROR",
                              "timeout_ms must be > 0; got %d", (int)timeout_ms);
        return QoreValue();
    }

    AutoLocker al(lock);

    linenoiseSetReadTimeout(timeout_ms);
    char* ret = linenoise(prompt->c_str());
    int kt = linenoiseKeyType();
    linenoiseSetReadTimeout(0);  // always reset timeout

    static const int LINENOISE_KEY_TYPE_TIMEOUT = 3;
    if (kt == LINENOISE_KEY_TYPE_TIMEOUT) {
        if (ret) {
            free(ret);
        }
        xsink->raiseException("LINENOISE-TIMEOUT-ERROR",
                              "read timeout of %d ms expired", (int)timeout_ms);
        return QoreValue();
    }

    if (ret) {
        QoreStringNode* s = new QoreStringNode(ret);
        free(ret);
        return s;
    } else {
        return nothing();
    }
}

//! Set syntax highlighting callback
/**
    The callback receives the current input line as a string and should return
    a string containing ANSI escape codes for colorization. The returned string
    must contain the same visible characters as the input, but may include ANSI
    SGR sequences (e.g., @c "\\x1b[31m" for red) around tokens.

    When a syntax callback is set:
    - The callback is called on every screen refresh
    - Brace/bracket highlighting overlays the syntax colors for the matched character
    - Syntax highlighting is disabled in mask mode and during incremental search

    Pass @ref nothing "NOTHING" to clear the callback.

    @param callback a function/method reference or closure that receives a string and returns
    a colorized string, or @ref nothing "NOTHING" to clear

    @par Example
    @code{.py}
Linenoise::set_syntax_callback(sub (string input) {
    # Simple keyword highlighting example
    string output = regex_subst(input, "\\b(if|else|while|for)\\b", "\x1b[1;33m$1\x1b[0m", RE_Global);
    return output;
});
    @endcode

    @since linenoise 1.2.0
 */
nothing set_syntax_callback(*code callback) {
    AutoLocker al(lock);

    if (syntaxCallbackNode) {
        syntaxCallbackNode->deref(xsink);
    }
    if (callback) {
        syntaxCallbackNode = callback->refRefSelf();
    } else {
        syntaxCallbackNode = nullptr;
    }
}

//! Set or clear the right-side prompt
/**
    Sets a prompt string that is displayed at the right edge of the terminal,
    rendered in dim text. The right prompt is only displayed when the input
    fits on a single line and there is sufficient space between the input
    and the right edge.

    Pass @ref nothing "NOTHING" or an empty string to clear the right prompt.

    @param prompt the right prompt string, or @ref nothing "NOTHING" to clear

    @par Example
    @code{.py}
Linenoise::set_right_prompt("[ins]");
# Now the right side of the terminal shows "[ins]" in dim text
Linenoise::set_right_prompt();  # clear the right prompt
    @endcode

    @since linenoise 1.2.0
 */
nothing set_right_prompt(*string prompt) {
    AutoLocker al(lock);

    if (prompt && prompt->strlen() > 0) {
        linenoiseSetRightPrompt(prompt->c_str());
    } else {
        linenoiseSetRightPrompt(nullptr);
    }
}

//! Bind a custom callback to a key combination
/**
    Registers a Qore callback to be invoked when the specified key combination
    is pressed during @ref Qore::Linenoise::line() editing. User bindings take
    priority over built-in key handlers.

    The key specification is a case-insensitive string describing the key combo:
    - Single character: @c "a", @c "x", @c "space"
    - With modifiers: @c "ctrl-a", @c "meta-d", @c "ctrl-left", @c "meta-shift-d"
    - Modifier aliases: @c alt is the same as @c meta
    - Special keys: @c left, @c right, @c up, @c down, @c home, @c end,
      @c delete, @c pageup, @c pagedown, @c insert, @c backspace, @c tab,
      @c return

    The callback receives a hash with keys:
    - @c line (string): the current edit buffer contents
    - @c pos (int): the cursor position in characters

    The callback should return one of:
    - a hash with @c line (string) and/or @c pos (int) keys to update the buffer
    - @ref nothing "NOTHING" to leave the buffer unchanged

    @param key_spec a key specification string
    @param callback the callback code to invoke

    @throw LINENOISE-KEY-SPEC-ERROR invalid key specification string

    @par Example
    @code{.py}
# Bind ctrl-x to clear the line
Linenoise::bind_key("ctrl-x", hash<auto> sub (hash<auto> info) {
    return {"line": "", "pos": 0};
});
    @endcode

    @since linenoise 1.2.0
 */
nothing bind_key(string key_spec, code callback) {
    AutoLocker al(lock);

    int keyCode = parseKeySpec(key_spec->c_str(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Store a reference to the Qore callback
    ResolvedCallReferenceNode* cbRef = callback->refRefSelf();

    // If there's an existing binding for this key, deref the old callback
    auto it = keyBindingCallbacks.find(keyCode);
    if (it != keyBindingCallbacks.end()) {
        if (it->second) {
            it->second->deref(xsink);
        }
        it->second = cbRef;
    } else {
        keyBindingCallbacks[keyCode] = cbRef;
    }

    // Register with linenoise, passing the callback pointer as userData
    linenoiseBindKey(keyCode, static_cast<void*>(cbRef));
}

//! Remove a custom key binding
/**
    Removes a previously registered custom key binding, restoring the default
    behavior for that key combination.

    @param key_spec a key specification string (same format as @ref Qore::Linenoise::bind_key())

    @throw LINENOISE-KEY-SPEC-ERROR invalid key specification string

    @par Example
    @code{.py}
Linenoise::unbind_key("ctrl-x");
    @endcode

    @since linenoise 1.2.0
 */
nothing unbind_key(string key_spec) {
    AutoLocker al(lock);

    int keyCode = parseKeySpec(key_spec->c_str(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Remove from linenoise
    linenoiseUnbindKey(keyCode);

    // Deref and remove the stored callback
    auto it = keyBindingCallbacks.find(keyCode);
    if (it != keyBindingCallbacks.end()) {
        if (it->second) {
            it->second->deref(xsink);
        }
        keyBindingCallbacks.erase(it);
    }
}

//! Set or clear a history provider for external history management
/**
    Registers an @ref Qore::Linenoise::AbstractHistoryProvider "AbstractHistoryProvider"
    subclass instance that controls Up/Down arrow history navigation and optionally
    Ctrl+R/S incremental search. When a history provider is set, the internal history
    array is not used for navigation; instead, the provider methods are invoked.

    Pass @ref nothing "NOTHING" to clear the provider and revert to internal history
    management.

    @param provider an @ref Qore::Linenoise::AbstractHistoryProvider "AbstractHistoryProvider"
    subclass instance, or @ref nothing "NOTHING" to clear the provider

    @par Example
    @code{.py}
class MyHistoryProvider inherits Linenoise::AbstractHistoryProvider {
    private {
        list<string> entries;
        int pos;
    }

    constructor(list<string> e) {
        entries = e;
        pos = entries.size();
    }

    *string prev(string prefix) {
        if (pos > 0) {
            return entries[--pos];
        }
    }

    *string next(string prefix) {
        if (pos < entries.size() - 1) {
            return entries[++pos];
        }
    }

    nothing reset() {
        pos = entries.size();
    }
}

auto provider = new MyHistoryProvider(("line1", "line2", "line3"));
Linenoise::set_history_provider(provider);
# Clear the provider
Linenoise::set_history_provider();
    @endcode

    @since linenoise 1.2.0
 */
nothing set_history_provider(*AbstractHistoryProvider[HistoryProviderPriv] provider) {
    // Check for error from private data extraction (e.g., object already deleted)
    if (*xsink) {
        return QoreValue();
    }

    // Use ReferenceHolder to ensure exception-safe ownership of the new provider
    // reference (from getReferencedPrivateData); release() transfers ownership
    ReferenceHolder<HistoryProviderPriv> holder(provider, xsink);

    AutoLocker al(lock);

    // Clear C callbacks before derefing old provider to avoid dangling state
    linenoiseSetHistoryProvider(NULL, NULL, NULL, NULL, NULL);

    // Deref existing provider
    if (historyProviderPriv) {
        historyProviderPriv->deref(xsink);
        historyProviderPriv = nullptr;
    }
    if (historyProviderObj) {
        historyProviderObj->deref(xsink);
        historyProviderObj = nullptr;
    }

    if (provider) {
        // obj_provider is the const QoreObject* (generated by qpp macro)
        historyProviderObj = const_cast<QoreObject*>(obj_provider);
        historyProviderObj->ref();
        historyProviderPriv = holder.release();

        linenoiseSetHistoryProvider(
            qore_history_provider_prev_cb,
            qore_history_provider_next_cb,
            qore_history_provider_reset_cb,
            historyProviderPriv->hasSearchOverride()
                ? qore_history_provider_search_cb : NULL,
            NULL
        );
    }
}

//! Start an async line editing session
/**
    Creates a new non-blocking line editing session. The caller feeds
    individual bytes via @ref Qore::Linenoise::edit_feed() and retrieves
    the result via @ref Qore::Linenoise::edit_get_line(). This enables
    event-loop integration (e.g., with ncurses or select/poll).

    @param prompt a custom string with prompt

    @return an integer session ID for use with other edit_* functions

    @par Example
    @code{.py}
int sid = Linenoise::edit_start("prompt> ");
Linenoise::edit_set_silent(sid, True);
# ... feed bytes from event loop ...
Linenoise::edit_stop(sid);
    @endcode

    @since linenoise 1.2.0
 */
int edit_start(string prompt) {
    AutoLocker al(lock);

    linenoiseState* state = linenoiseEditStart(prompt->c_str());
    if (!state) {
        xsink->raiseException("LINENOISE-EDIT-ERROR", "failed to create editing session");
        return 0;
    }
    int64_t sid = nextSessionId++;
    activeSessions[sid] = state;
    return sid;
}

//! Feed a byte to an async editing session
/**
    Feeds a single byte to the editing session for processing. The byte
    is handled as part of the UTF-8 and escape sequence state machine.

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()
    @param byte_val the byte value to feed (0-255)

    @return an integer result code:
    - @c 0 (LN_FEED_MORE): need more input
    - @c 1 (LN_FEED_DONE): line accepted (Enter pressed)
    - @c -1 (LN_FEED_ABORT): aborted (Ctrl+C)
    - @c -2 (LN_FEED_EXIT): exit (Ctrl+D on empty line)

    @par Example
    @code{.py}
int rv = Linenoise::edit_feed(sid, byte_val);
if (rv == 1) {
    *string line = Linenoise::edit_get_line(sid);
    printf("Got: %s\n", line);
} else if (rv == -1) {
    printf("Ctrl+C\n");
} else if (rv == -2) {
    printf("Ctrl+D\n");
}
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
int edit_feed(int session, int byte_val) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return -1;
    }
    return linenoiseEditFeed(it->second, static_cast<char>(byte_val & 0xFF));
}

//! Get the completed line from an async editing session
/**
    After @ref Qore::Linenoise::edit_feed() returns @c 1 (LN_FEED_DONE),
    call this function to retrieve the completed line.

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()

    @return the completed line string, or @ref nothing "NOTHING" if the line
    is not ready or the session was aborted

    @par Example
    @code{.py}
if (Linenoise::edit_feed(sid, byte_val) == 1) {
    *string line = Linenoise::edit_get_line(sid);
    if (exists line) {
        Linenoise::history_add(line);
    }
}
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
*string edit_get_line(int session) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return QoreValue();
    }
    char* line = linenoiseEditGetLine(it->second);
    if (line) {
        QoreStringNode* s = new QoreStringNode(line);
        free(line);
        return s;
    }
    return nothing();
}

//! Stop an async editing session and clean up resources
/**
    Stops the editing session, restores terminal state, and frees
    all resources associated with the session. The session ID becomes
    invalid after this call.

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
nothing edit_stop(int session) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return QoreValue();
    }
    linenoiseEditStop(it->second);
    activeSessions.erase(it);
}

//! Get the file descriptor for the editing session's input
/**
    Returns the file descriptor that should be monitored for readability
    in a select/poll loop. When data is available on this descriptor,
    read one byte and pass it to @ref Qore::Linenoise::edit_feed().

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()

    @return the input file descriptor (typically stdin)

    @par Example
    @code{.py}
int sid = Linenoise::edit_start("prompt> ");
int fd = Linenoise::edit_fd(sid);
# Use fd with select() or poll() to wait for input
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
int edit_fd(int session) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return -1;
    }
    return linenoiseEditFd(it->second);
}

//! Get the current editing buffer contents and cursor position
/**
    Returns the current state of the editing buffer for external rendering.

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()

    @return a hash with keys:
    - \c text (string): the current buffer contents
    - \c cursor (int): the cursor position in characters
    - \c len (int): the buffer length in characters

    @par Example
    @code{.py}
hash<auto> buf = Linenoise::edit_get_buffer(sid);
# Render: buf.text with cursor at position buf.cursor
printf("buffer: '%s' cursor=%d len=%d\n", buf.text, buf.cursor, buf.len);
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
hash<auto> edit_get_buffer(int session) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return QoreValue();
    }
    int cursor_pos = 0;
    int buf_len = 0;
    const char* text = linenoiseEditGetBuffer(it->second, &cursor_pos, &buf_len);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("text", new QoreStringNode(text ? text : "", QCS_UTF8), xsink);
    h->setKeyValue("cursor", cursor_pos, xsink);
    h->setKeyValue("len", buf_len, xsink);
    return h.release();
}

//! Enable or disable silent mode for an async editing session
/**
    When silent mode is enabled, the editing session does not write any
    output to the terminal. This is useful when the caller handles all
    rendering externally (e.g., via ncurses).

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()
    @param silent \c True to enable silent mode, \c False to disable

    @par Example
    @code{.py}
int sid = Linenoise::edit_start("prompt> ");
# Enable silent mode for external rendering (e.g., ncurses)
Linenoise::edit_set_silent(sid, True);
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
nothing edit_set_silent(int session, bool silent) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return QoreValue();
    }
    linenoiseEditSetSilent(it->second, silent ? 1 : 0);
}

//! Get the key type from the last resolved async editing session result
/**
    Returns the type of key that caused the session to resolve. This is
    analogous to @ref Qore::Linenoise::key_type() for the blocking API.

    @param session the session ID returned by @ref Qore::Linenoise::edit_start()

    @return an integer key type code:
    - @c 0: normal (Enter)
    - @c 1: Ctrl+C (abort)
    - @c 2: Ctrl+D (exit)

    @par Example
    @code{.py}
int rv = Linenoise::edit_feed(sid, byte_val);
if (rv != 0) {
    int kt = Linenoise::edit_key_type(sid);
    if (kt == 1) {
        printf("User pressed Ctrl+C\n");
    }
}
    @endcode

    @throw LINENOISE-SESSION-ERROR invalid session ID

    @since linenoise 1.2.0
 */
int edit_key_type(int session) {
    AutoLocker al(lock);

    auto it = activeSessions.find(session);
    if (it == activeSessions.end()) {
        xsink->raiseException("LINENOISE-SESSION-ERROR",
                              "invalid session ID: %d", session);
        return 0;
    }
    return linenoiseEditKeyType(it->second);
}
///@}
